# 이 파일을 .env.local로 복사하고 값을 채워 주세요. 실제 값은 커밋하지 않아요.

# 앱 주소예요. OAuth 콜백 주소를 만들 때 써요(끝에 / 없이).
APP_URL=http://localhost:3000
# 세션 쿠키 서명 키예요. 32자 이상 무작위 문자열을 넣어 주세요(openssl rand -base64 48).
AUTH_SECRET=
# 로그인을 허용할 이메일이에요. 개인 Gmail을 먼저 쓰고, 예비로 회사 메일을 쉼표로 이어 쓸 수 있어요(예: me@gmail.com,me@company.com).
ALLOWED_EMAIL=
# Google Cloud 콘솔에서 만든 OAuth 클라이언트 ID예요.
GOOGLE_CLIENT_ID=
# 같은 OAuth 클라이언트의 비밀번호예요.
GOOGLE_CLIENT_SECRET=
# Google 토큰 암호화 키예요. base64로 쓴 32바이트여야 해요(openssl rand -base64 32).
ENCRYPTION_KEY=
# 비우거나 pglite:로 시작하면 로컬 PGlite 파일을, 아니면 Postgres(Supabase) 주소를 써요.
DATABASE_URL=pglite:./.data/pglite
# 웹 푸시 공개 키예요. 브라우저로 나가는 유일한 값이에요(npx web-push generate-vapid-keys).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 웹 푸시 비공개 키예요. 위 공개 키와 한 쌍으로 만든 값을 넣어 주세요.
VAPID_PRIVATE_KEY=
# 웹 푸시 발신자 정보예요. mailto:본인이메일 형식으로 넣어 주세요.
VAPID_SUBJECT=
# 외부 cron이 /api/cron/tick을 부를 때 쓰는 Bearer 토큰이에요. 16자 이상으로 넣어 주세요.
CRON_SECRET=
# 1이면 개발용 로그인을 켜요. NODE_ENV가 production이면 무시돼요.
DEV_LOGIN=
